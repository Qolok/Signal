--- a/index.html
+++ b/index.html
@@ -2,6 +2,26 @@
 <html lang="en">
   <head>
     <meta charset="UTF-8" />
+    <!--
+      Content-Security-Policy (defense-in-depth for stored-HTML injection).
+      Enumerated origins the game actually loads:
+        script-src : self + Firebase compat SDK (www.gstatic.com) + marked (cdn.jsdelivr.net)
+                     + reCAPTCHA (www.google.com + www.gstatic.com) used by Firebase
+                     App Check when a production reCAPTCHA v3 site key is configured
+        connect-src: self + Firebase Auth/Installations/App Check (*.googleapis.com),
+                     Realtime Database (*.firebaseio.com over https + wss),
+                     auth domain (signal-serve.firebaseapp.com)
+        frame-src  : self + reCAPTCHA challenge iframe (www.google.com)
+        img/media/font-src: self (all art, audio and the favicon are same-origin)
+      No 'unsafe-inline' in script-src — inline handlers were refactored into
+      ui-events.js. 'unsafe-inline' is kept only for style-src (inline style="").
+      frame-ancestors / X-Content-Type-Options / Referrer-Policy are delivered as
+      HTTP headers (see serve.json) since a <meta> CSP cannot carry them.
+    -->
+    <meta
+      http-equiv="Content-Security-Policy"
+      content="default-src 'self'; script-src 'self' https://www.gstatic.com https://cdn.jsdelivr.net https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://signal-serve.firebaseapp.com; frame-src 'self' https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
+    />
     <meta
       name="viewport"
       content="width=device-width, initial-scale=1.0, user-scalable=no"
